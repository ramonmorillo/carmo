# CARMO · variables de entorno del frontend (Vite). Copiar a .env (no versionado).
# CARMO comparte proyecto Supabase con DERMAPEX y COAMO: mismos valores públicos.
# Solo la clave PÚBLICA (anon/publishable). NUNCA la service-role key en el frontend.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY

# Opcional, solo en build: ruta base de publicación (por defecto '/').
# CARMO_BASE_PATH=/carmo/
